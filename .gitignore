# Dependencies — restored by `npm install`, never committed.
node_modules/

# Build output.
dist/
dist-ssr/
.vite/

# Test artefacts: both are generated by the test run itself.
# `tests/fixtures.mjs` is the generator and *is* committed; the folder it
# writes is not.
tests/fixtures/
tests/screenshots/

# Local and editor noise.
*.local
.env
.env.*
.DS_Store
.idea/

